{
  "name": "anywear-infra",
  "version": "0.1.0",
  "overrides": {
    "brace-expansion": "5.0.12",
    "minimatch": "10.2.6"
  },
  "bin": {
    "infra": "bin/infra.js"
  },
  "scripts": {
    "audit:prod": "node scripts/audit-production.mjs",
    "build": "tsc",
    "watch": "tsc -w",
    "test": "npm run build && jest",
    "cdk": "cdk",
    "test:cdk": "npm run build && jest --runInBand",
    "test:contracts": "node --test scripts/*.test.mjs .github/scripts/*.test.mjs",
    "check": "npm run test:cdk && npm run test:contracts"
  },
  "devDependencies": {
    "@types/jest": "^30",
    "@types/node": "~24.12.0",
    "aws-cdk": "2.1136.0",
    "esbuild": "^0.28.0",
    "jest": "^30.3.0",
    "js-yaml": "^4.3.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.2"
  },
  "dependencies": {
    "aws-cdk-lib": "2.272.0",
    "constructs": "^10.6.0"
  },
  "allowScripts": {
    "esbuild@0.28.0": true,
    "unrs-resolver@1.11.1": true
  }
}
